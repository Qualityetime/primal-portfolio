    "test:quick": "node --test tests/portfolio/*.test.js",
    "check:dist": "node scripts/check-dist.mjs dist"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.2"
  }
}
