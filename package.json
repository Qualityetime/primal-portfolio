{
  "name": "primal-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project Primal: Portfolio Edition. A standalone single-player React + Three.js hunting demo derived from the Primal Co-op multiplayer prototype. Static site, no backend.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
